---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const navLinks = [
  { href: '#nosaltres', label: t.nav.about },
  { href: '#especialitats', label: t.nav.specialties },
  { href: '#carta', label: t.nav.menu },
  { href: '#galeria', label: t.nav.gallery },
  { href: '#contacte', label: t.nav.contact },
];
---

<footer class="relative border-t border-ember-500/15 mt-10">
  <div class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-ember-500/60 to-transparent"></div>

  <div class="container-px mx-auto max-w-7xl py-16">
    <div class="grid md:grid-cols-3 gap-10 items-start">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img src="/img/logo-black.png" alt="" class="h-12 w-12 object-contain" loading="lazy" />
          <div>
            <p class="font-display text-xl uppercase tracking-[0.2em] text-ember-100">La Patum</p>
            <p class="font-serif italic text-sm text-ember-300/80">{t.hero.tagline}</p>
          </div>
        </div>
        <p class="font-serif text-sm text-coal-50/70 leading-relaxed max-w-sm">
          {t.footer.desc}
        </p>
      </div>

      <div>
        <p class="font-display uppercase tracking-widest text-ember-300 text-sm mb-4">{t.footer.nav}</p>
        <ul class="space-y-2 text-coal-50/80 font-serif">
          {
            navLinks.map((l) => (
              <li><a href={l.href} class="hover:text-ember-200 transition">{l.label}</a></li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="font-display uppercase tracking-widest text-ember-300 text-sm mb-4">{t.footer.contact}</p>
        <ul class="space-y-2 text-coal-50/80 font-serif text-sm">
          <li>{t.contact.blocks.address.line1}</li>
          <li>{t.contact.blocks.address.line2}</li>
          <li><a href="tel:+34938151893" class="hover:text-ember-200 transition">938 151 893</a></li>
          <li><a href="tel:+34630637900" class="hover:text-ember-200 transition">630 637 900</a></li>
        </ul>

        <div class="mt-5 flex items-center gap-3">
          <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" aria-label="Facebook"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-ember-500/25 text-ember-200 hover:bg-flame-gradient hover:text-coal-500 transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
          </a>
          <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-ember-500/25 text-ember-200 hover:bg-flame-gradient hover:text-coal-500 transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer" aria-label="YouTube"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-ember-500/25 text-ember-200 hover:bg-flame-gradient hover:text-coal-500 transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6Z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="divider-flame mt-12 mb-6"></div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-coal-50/55 font-sans">
      <p>© {year} La Patum · Tapes &amp; Més. {t.footer.rights}</p>
      <p class="font-display tracking-[0.3em] uppercase text-ember-400/60">
        {t.footer.motto}
      </p>
    </div>

    <div class="mt-6 flex justify-center">
      <a
        href="https://www.tanesolutions.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.32em] text-coal-50/45 hover:text-ember-300 transition"
      >
        <span>{t.footer.poweredBy}</span>
        <span class="font-display tracking-[0.18em] text-ember-300/80 group-hover:text-ember-200 transition">
          Tane Solutions
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60 group-hover:opacity-100 group-hover:translate-x-0.5 transition">
          <path d="M7 17L17 7"/>
          <path d="M7 7h10v10"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
