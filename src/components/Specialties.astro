---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="especialitats" class="section relative">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-ember-500/40 to-transparent"></div>

  <div class="mx-auto max-w-7xl">
    <div class="text-center mb-16 max-w-2xl mx-auto">
      <p class="font-sans uppercase tracking-[0.35em] text-ember-400 text-xs mb-4">
        {t.specialties.eyebrow}
      </p>
      <h2 class="heading-display text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
        {t.specialties.titleLeft} <span class="text-fire">{t.specialties.titleHighlight}</span> {t.specialties.titleRight}
      </h2>
      <div class="divider-flame mb-6 mx-auto w-32"></div>
      <p class="font-serif text-lg text-coal-50/80">
        {t.specialties.intro}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        t.specialties.items.map((item) => (
          <article class="card p-7 group">
            <div class="flex items-center gap-4 mb-4">
              <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-coal-300/60 border border-ember-500/20 text-3xl group-hover:scale-110 transition">
                {item.icon}
              </div>
              <h3 class="heading-display text-xl text-ember-100">{item.title}</h3>
            </div>
            <p class="font-serif text-coal-50/80 leading-relaxed">{item.desc}</p>
            <div class="mt-5 h-px bg-gradient-to-r from-ember-500/40 to-transparent"></div>
          </article>
        ))
      }
    </div>
  </div>
</section>
