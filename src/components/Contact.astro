---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contacte" class="section relative">
  <div class="absolute inset-0 -z-10 bg-fire-radial opacity-50"></div>

  <div class="mx-auto max-w-7xl">
    <div class="text-center mb-14 max-w-2xl mx-auto">
      <p class="font-sans uppercase tracking-[0.35em] text-ember-400 text-xs mb-4">
        {t.contact.eyebrow}
      </p>
      <h2 class="heading-display text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
        {t.contact.titleLeft} <span class="text-fire">{t.contact.titleHighlight}</span> {t.contact.titleRight}
      </h2>
      <div class="divider-flame mb-6 mx-auto w-32"></div>
      <p class="font-serif text-lg text-coal-50/80">{t.contact.intro}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      <div class="card p-8 lg:p-10 space-y-6">
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-flame-gradient text-coal-500 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <p class="font-display uppercase tracking-widest text-ember-300 text-sm mb-1">{t.contact.blocks.address.title}</p>
            <p class="font-serif text-coal-50/90">{t.contact.blocks.address.line1}</p>
            <p class="font-serif text-coal-50/90">{t.contact.blocks.address.line2}</p>
          </div>
        </div>

        <div class="divider-flame"></div>

        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-flame-gradient text-coal-500 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div>
            <p class="font-display uppercase tracking-widest text-ember-300 text-sm mb-1">{t.contact.blocks.phones.title}</p>
            <a href="tel:+34938151893" class="block font-serif text-coal-50/90 hover:text-ember-200 transition">938 151 893</a>
            <a href="tel:+34630637900" class="block font-serif text-coal-50/90 hover:text-ember-200 transition">630 637 900</a>
          </div>
        </div>

        <div class="divider-flame"></div>

        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-flame-gradient text-coal-500 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="flex-1">
            <p class="font-display uppercase tracking-widest text-ember-300 text-sm mb-2">{t.contact.blocks.hours.title}</p>
            <ul class="font-serif text-coal-50/90 space-y-1 text-sm">
              {
                t.contact.blocks.hours.rows.map((row, i) => (
                  <li class="flex justify-between gap-4">
                    <span>{row.left}</span>
                    <span class={i === 1 ? 'text-flame' : 'text-ember-200'}>{row.right}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="pt-2 flex flex-wrap gap-3">
          <a href="tel:+34938151893" class="btn-fire">
            {t.contact.cta1}
          </a>
          <a
            href="https://maps.google.com/?q=Passeig+del+Carme+46+Vilanova+i+la+Geltrú"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost"
          >
            {t.contact.cta2}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7"/>
              <path d="M7 7h10v10"/>
            </svg>
          </a>
        </div>
      </div>

      <form
        class="card p-8 lg:p-10 space-y-5"
        data-success={t.contact.form.success}
        onsubmit="event.preventDefault(); alert(this.dataset.success);"
      >
        <div>
          <label for="nom" class="block font-display uppercase tracking-widest text-xs text-ember-300 mb-2">{t.contact.form.name}</label>
          <input id="nom" name="nom" type="text" required
            class="w-full rounded-xl bg-coal-300/60 border border-ember-500/20 px-4 py-3 text-coal-50 placeholder-coal-50/40 focus:border-ember-400 focus:outline-none focus:ring-2 focus:ring-ember-500/30 transition"
            placeholder={t.contact.form.namePlaceholder} />
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="telefon" class="block font-display uppercase tracking-widest text-xs text-ember-300 mb-2">{t.contact.form.phone}</label>
            <input id="telefon" name="telefon" type="tel" required
              class="w-full rounded-xl bg-coal-300/60 border border-ember-500/20 px-4 py-3 text-coal-50 placeholder-coal-50/40 focus:border-ember-400 focus:outline-none focus:ring-2 focus:ring-ember-500/30 transition"
              placeholder={t.contact.form.phonePlaceholder} />
          </div>
          <div>
            <label for="comensals" class="block font-display uppercase tracking-widest text-xs text-ember-300 mb-2">{t.contact.form.guests}</label>
            <input id="comensals" name="comensals" type="number" min="1" max="40"
              class="w-full rounded-xl bg-coal-300/60 border border-ember-500/20 px-4 py-3 text-coal-50 placeholder-coal-50/40 focus:border-ember-400 focus:outline-none focus:ring-2 focus:ring-ember-500/30 transition"
              placeholder={t.contact.form.guestsPlaceholder} />
          </div>
        </div>
        <div>
          <label for="data" class="block font-display uppercase tracking-widest text-xs text-ember-300 mb-2">{t.contact.form.date}</label>
          <input id="data" name="data" type="date"
            class="w-full rounded-xl bg-coal-300/60 border border-ember-500/20 px-4 py-3 text-coal-50 placeholder-coal-50/40 focus:border-ember-400 focus:outline-none focus:ring-2 focus:ring-ember-500/30 transition" />
        </div>
        <div>
          <label for="missatge" class="block font-display uppercase tracking-widest text-xs text-ember-300 mb-2">{t.contact.form.message}</label>
          <textarea id="missatge" name="missatge" rows="4"
            class="w-full rounded-xl bg-coal-300/60 border border-ember-500/20 px-4 py-3 text-coal-50 placeholder-coal-50/40 focus:border-ember-400 focus:outline-none focus:ring-2 focus:ring-ember-500/30 transition resize-none"
            placeholder={t.contact.form.messagePlaceholder}></textarea>
        </div>
        <button type="submit" class="btn-fire w-full justify-center">
          {t.contact.form.submit}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>
        <p class="text-xs font-serif italic text-coal-50/55 text-center">
          {t.contact.form.foot}
        </p>
      </form>
    </div>
  </div>
</section>
