---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const images = [
  '/img/menjar/hamburguesa-local.jpg',
  '/img/menjar/amanida-burrata.jpg',
  '/img/menjar/encebollat.jpg',
  '/img/menjar/pastis-casola.jpg',
  '/img/menjar/postre-merenga.jpg',
];
const spans = ['md:col-span-2 md:row-span-2', '', '', '', ''];
---

<section id="galeria" class="section relative">
  <div class="mx-auto max-w-7xl">
    <div class="text-center mb-14 max-w-2xl mx-auto">
      <p class="font-sans uppercase tracking-[0.35em] text-ember-400 text-xs mb-4">
        {t.gallery.eyebrow}
      </p>
      <h2 class="heading-display text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
        {t.gallery.titleLeft} <span class="text-fire">{t.gallery.titleHighlight}</span> {t.gallery.titleRight}
      </h2>
      <div class="divider-flame mb-6 mx-auto w-32"></div>
      <p class="font-serif text-lg text-coal-50/80">{t.gallery.intro}</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 auto-rows-[200px] md:auto-rows-[240px] gap-4">
      {
        t.gallery.tiles.map((tile, i) => (
          <figure class={`relative overflow-hidden rounded-2xl group cursor-pointer ${spans[i]}`}>
            <img
              src={images[i]}
              alt={tile.title}
              class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-coal-500 via-coal-500/35 to-transparent" />
            <div class="absolute inset-0 bg-gradient-to-tr from-flame-deep/15 via-transparent to-ember-500/10 mix-blend-overlay opacity-0 group-hover:opacity-100 transition duration-500" />
            <figcaption class="absolute bottom-4 left-5 right-5 z-10">
              <p class="font-sans uppercase tracking-[0.25em] text-xs text-ember-200/90 mb-1">
                {tile.subtitle}
              </p>
              <p class="font-display text-lg md:text-xl text-coal-50 tracking-wide">
                {tile.title}
              </p>
            </figcaption>
            <div class="absolute inset-0 ring-1 ring-inset ring-ember-500/20 rounded-2xl pointer-events-none group-hover:ring-ember-400/50 transition" />
          </figure>
        ))
      }
    </div>

    <p class="text-center font-serif italic text-sm text-coal-50/55 mt-10">
      {t.gallery.foot}
    </p>
  </div>
</section>
