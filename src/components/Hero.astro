---
import { useTranslations, type Lang } from '../i18n';
import EmbersCanvas from './EmbersCanvas.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const stats = [
  t.hero.stats.hours,
  t.hero.stats.tuesday,
  t.hero.stats.summer,
  t.hero.stats.tapas,
];
---

<section
  id="inici"
  class="relative min-h-[100svh] flex items-center justify-center overflow-hidden pt-20 pb-10 md:pt-24 md:pb-0"
>
  <div class="absolute inset-0 -z-10 bg-fire-radial"></div>
  <EmbersCanvas intensity={1.2} />

  <div
    class="absolute left-1/2 top-1/2 -z-10 h-[70vmin] w-[70vmin] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-60 blur-3xl"
    style="background: radial-gradient(circle, rgba(255,140,30,0.45) 0%, rgba(200,57,10,0.25) 40%, transparent 70%);"
  >
  </div>

  <div class="container-px mx-auto max-w-7xl text-center">
    <p class="mb-3 sm:mb-6 inline-block font-sans text-[11px] sm:text-sm tracking-[0.4em] uppercase text-ember-300/90">
      <span class="opacity-70">·</span> {t.hero.location} <span class="opacity-70">·</span>
    </p>

    <div class="relative mb-3 sm:mb-6 flex justify-center">
      <img
        src="/img/logo-original.png"
        alt="La Patum"
        class="h-28 w-28 sm:h-44 sm:w-44 md:h-56 md:w-56 lg:h-64 lg:w-64 object-contain drop-shadow-[0_0_18px_rgba(255,140,30,0.5)] md:drop-shadow-none md:animate-glowPulse"
        loading="eager"
      />
    </div>

    <h1 class="heading-display text-fire text-4xl sm:text-6xl md:text-7xl lg:text-8xl leading-none mb-2 sm:mb-4 md:animate-flicker">
      La Patum
    </h1>
    <p class="font-serif italic text-ember-200/90 text-lg sm:text-2xl md:text-3xl mb-4 sm:mb-8 tracking-wide">
      {t.hero.tagline}
    </p>

    <p class="mx-auto max-w-2xl font-serif text-sm sm:text-lg md:text-xl text-coal-50/85 leading-relaxed mb-6 sm:mb-10 px-2">
      {t.hero.intro}
    </p>

    <div class="flex flex-row items-center justify-center gap-2 sm:gap-4">
      <a href="#contacte" class="btn-fire !px-4 !py-2.5 text-sm sm:!px-7 sm:!py-3 sm:text-base">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        {t.hero.cta}
      </a>
      <a href="#carta" class="btn-ghost !px-4 !py-2.5 text-sm sm:!px-7 sm:!py-3 sm:text-base">
        {t.hero.secondaryCta}
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

    <div class="mt-6 sm:mt-12 md:mt-16 grid grid-cols-4 gap-2 sm:gap-6 max-w-3xl mx-auto">
      {
        stats.map((s) => (
          <div class="text-center min-w-0">
            <p class="font-display text-base sm:text-2xl text-fire whitespace-nowrap">{s.value}</p>
            <p class="text-[9px] sm:text-xs uppercase tracking-wider sm:tracking-widest text-coal-50/60 mt-0.5 sm:mt-1 leading-tight">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>

  <a
    href="#nosaltres"
    class="hidden md:block absolute bottom-8 left-1/2 -translate-x-1/2 text-ember-300/70 hover:text-ember-200 animate-bounce"
    aria-label={t.hero.scroll}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </a>
</section>

