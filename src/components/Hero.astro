---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const stats = [
  t.hero.stats.hours,
  t.hero.stats.tuesday,
  t.hero.stats.summer,
  t.hero.stats.tapas,
];
---

<section
  id="inici"
  class="relative min-h-screen flex items-center justify-center overflow-hidden pt-24"
>
  <div class="absolute inset-0 -z-10 bg-fire-radial"></div>
  <div id="embers" class="absolute inset-0 -z-10 pointer-events-none overflow-hidden"></div>

  <div
    class="absolute left-1/2 top-1/2 -z-10 h-[70vmin] w-[70vmin] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-60 blur-3xl"
    style="background: radial-gradient(circle, rgba(255,140,30,0.45) 0%, rgba(200,57,10,0.25) 40%, transparent 70%);"
  >
  </div>

  <div class="container-px mx-auto max-w-7xl text-center">
    <p class="mb-6 inline-block font-sans text-xs sm:text-sm tracking-[0.4em] uppercase text-ember-300/90">
      <span class="opacity-70">·</span> {t.hero.location} <span class="opacity-70">·</span>
    </p>

    <div class="relative mb-6 flex justify-center">
      <img
        src="/img/logo-original.png"
        alt="La Patum"
        class="h-44 w-44 sm:h-56 sm:w-56 md:h-64 md:w-64 object-contain animate-glowPulse"
        loading="eager"
      />
    </div>

    <h1 class="heading-display text-fire text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-none mb-4 animate-flicker">
      La Patum
    </h1>
    <p class="font-serif italic text-ember-200/90 text-xl sm:text-2xl md:text-3xl mb-8 tracking-wide">
      {t.hero.tagline}
    </p>

    <p class="mx-auto max-w-2xl font-serif text-lg md:text-xl text-coal-50/85 leading-relaxed mb-10">
      {t.hero.intro}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#contacte" class="btn-fire">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        {t.hero.cta}
      </a>
      <a href="#carta" class="btn-ghost">
        {t.hero.secondaryCta}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

    <div class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-3xl mx-auto text-left">
      {
        stats.map((s) => (
          <div class="text-center">
            <p class="font-display text-2xl text-fire">{s.value}</p>
            <p class="text-xs uppercase tracking-widest text-coal-50/60 mt-1">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>

  <a
    href="#nosaltres"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 text-ember-300/70 hover:text-ember-200 animate-bounce"
    aria-label={t.hero.scroll}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </a>
</section>

<script>
  const container = document.getElementById('embers');
  if (container) {
    const total = 24;
    for (let i = 0; i < total; i++) {
      const ember = document.createElement('span');
      ember.className = 'ember-particle';
      const left = Math.random() * 100;
      const delay = Math.random() * 8;
      const duration = 6 + Math.random() * 8;
      const size = 2 + Math.random() * 4;
      ember.style.left = `${left}%`;
      ember.style.width = `${size}px`;
      ember.style.height = `${size}px`;
      ember.style.animationDelay = `${delay}s`;
      ember.style.animationDuration = `${duration}s`;
      container.appendChild(ember);
    }
  }
</script>
