---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="carta" class="section relative bg-gradient-to-b from-transparent via-coal-300/30 to-transparent">
  <div class="mx-auto max-w-7xl">
    <div class="text-center mb-16 max-w-2xl mx-auto">
      <p class="font-sans uppercase tracking-[0.35em] text-ember-400 text-xs mb-4">
        {t.menu.eyebrow}
      </p>
      <h2 class="heading-display text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight">
        {t.menu.titleLeft} <span class="text-fire">{t.menu.titleHighlight}</span> {t.menu.titleRight}
      </h2>
      <div class="divider-flame mb-6 mx-auto w-32"></div>
      <p class="font-serif text-lg text-coal-50/80">
        {t.menu.intro}
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-10">
      <div class="card p-8">
        <header class="flex items-baseline justify-between mb-6 pb-4 border-b border-ember-500/20">
          <h3 class="heading-display text-2xl text-ember-100">{t.menu.sections.tapas.title}</h3>
          <span class="font-sans text-xs uppercase tracking-widest text-ember-400">{t.menu.sections.tapas.sub}</span>
        </header>
        <ul class="space-y-5">
          {
            t.menu.tapas.map((item) => (
              <li>
                <div class="flex items-baseline gap-3">
                  <p class="font-display tracking-wide text-ember-100">{item.name}</p>
                  <span class="flex-1 h-px border-t border-dashed border-ember-500/25"></span>
                  <p class="font-display text-fire">{item.price}</p>
                </div>
                <p class="font-serif text-sm text-coal-50/70 mt-1">{item.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card p-8">
        <header class="flex items-baseline justify-between mb-6 pb-4 border-b border-ember-500/20">
          <h3 class="heading-display text-2xl text-ember-100">{t.menu.sections.mains.title}</h3>
          <span class="font-sans text-xs uppercase tracking-widest text-ember-400">{t.menu.sections.mains.sub}</span>
        </header>
        <ul class="space-y-5">
          {
            t.menu.mains.map((item) => (
              <li>
                <div class="flex items-baseline gap-3">
                  <p class="font-display tracking-wide text-ember-100">{item.name}</p>
                  <span class="flex-1 h-px border-t border-dashed border-ember-500/25"></span>
                  <p class="font-display text-fire">{item.price}</p>
                </div>
                <p class="font-serif text-sm text-coal-50/70 mt-1">{item.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card p-8 lg:col-span-2">
        <header class="flex items-baseline justify-between mb-6 pb-4 border-b border-ember-500/20">
          <h3 class="heading-display text-2xl text-ember-100">{t.menu.sections.desserts.title}</h3>
          <span class="font-sans text-xs uppercase tracking-widest text-ember-400">{t.menu.sections.desserts.sub}</span>
        </header>
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-4">
          {
            t.menu.desserts.map((item) => (
              <li class="flex items-baseline gap-3">
                <p class="font-display tracking-wide text-ember-100">{item.name}</p>
                <span class="flex-1 h-px border-t border-dashed border-ember-500/25"></span>
                <p class="font-display text-fire">{item.price}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="text-center font-serif italic text-sm text-coal-50/60 mt-10 max-w-2xl mx-auto">
      {t.menu.note}
    </p>
  </div>
</section>
