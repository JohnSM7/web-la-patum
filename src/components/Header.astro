---
import { useTranslations, type Lang, locales, localeMeta, localizedPath } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: '#inici', label: t.nav.home },
  { href: '#nosaltres', label: t.nav.about },
  { href: '#especialitats', label: t.nav.specialties },
  { href: '#carta', label: t.nav.menu },
  { href: '#galeria', label: t.nav.gallery },
  { href: '#contacte', label: t.nav.contact },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
>
  <div
    class="container-px mx-auto flex max-w-7xl items-center justify-between py-4"
  >
    <a href={localizedPath(lang)} class="flex items-center gap-3 group">
      <img
        src="/img/logo-original.png"
        alt="La Patum"
        class="h-12 w-12 object-contain animate-glowPulse"
        loading="eager"
      />
      <span class="font-display text-xl tracking-[0.18em] uppercase text-ember-100 group-hover:text-ember-300 transition">
        La Patum
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-8">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="font-sans text-sm uppercase tracking-[0.15em] text-coal-50/80 hover:text-ember-300 transition relative after:absolute after:left-0 after:bottom-[-6px] after:h-px after:w-0 after:bg-ember-400 hover:after:w-full after:transition-all after:duration-300"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:flex items-center gap-4">
      {/* Selector idioma desktop */}
      <div class="flex items-center gap-1 rounded-full border border-ember-500/25 px-1 py-1 text-xs font-sans backdrop-blur-sm">
        {
          locales.map((l) => (
            <a
              href={localizedPath(l)}
              class={`px-2.5 py-1 rounded-full uppercase tracking-widest transition ${
                l === lang
                  ? 'bg-flame-gradient text-coal-500 font-semibold shadow-[0_4px_16px_-4px_rgba(255,107,26,0.5)]'
                  : 'text-coal-50/70 hover:text-ember-300'
              }`}
              aria-current={l === lang ? 'true' : undefined}
              hreflang={l}
            >
              {localeMeta[l].code}
            </a>
          ))
        }
      </div>

      <a href="tel:+34938151893" class="btn-fire text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        {t.nav.reserve}
      </a>
    </div>

    <button
      id="menu-toggle"
      class="lg:hidden text-ember-100 p-2"
      aria-label="Menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-ember-500/15 bg-coal-500/95 backdrop-blur-md"
  >
    <nav class="container-px mx-auto flex max-w-7xl flex-col gap-4 py-6">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="font-display tracking-[0.15em] uppercase text-coal-50/85 hover:text-ember-300 transition py-1"
          >
            {link.label}
          </a>
        ))
      }

      {/* Selector idioma mobile */}
      <div class="flex items-center gap-1 self-start rounded-full border border-ember-500/25 px-1 py-1 mt-2 text-xs">
        {
          locales.map((l) => (
            <a
              href={localizedPath(l)}
              class={`px-3 py-1 rounded-full uppercase tracking-widest font-sans transition ${
                l === lang
                  ? 'bg-flame-gradient text-coal-500 font-semibold'
                  : 'text-coal-50/70'
              }`}
              hreflang={l}
            >
              {localeMeta[l].code}
            </a>
          ))
        }
      </div>

      <a href="tel:+34938151893" class="btn-fire mt-2 self-start text-sm">
        {t.nav.reserve}: 938 151 893
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const mobile = document.getElementById('mobile-menu');

  const updateHeader = () => {
    if (!header) return;
    if (window.scrollY > 30) {
      header.classList.add('bg-coal-500/85', 'backdrop-blur-md', 'border-b', 'border-ember-500/15', 'shadow-[0_8px_30px_rgba(0,0,0,0.4)]');
    } else {
      header.classList.remove('bg-coal-500/85', 'backdrop-blur-md', 'border-b', 'border-ember-500/15', 'shadow-[0_8px_30px_rgba(0,0,0,0.4)]');
    }
  };

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  toggle?.addEventListener('click', () => {
    mobile?.classList.toggle('hidden');
  });

  mobile?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => mobile.classList.add('hidden'))
  );
</script>
