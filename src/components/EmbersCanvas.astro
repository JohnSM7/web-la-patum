---
interface Props {
  /** Densitat base d'espurnes (1 = densitat estàndard) */
  intensity?: number;
  /** Si vol fons obscur subtil amb resplendor inferior */
  withGlow?: boolean;
}
const { intensity = 1, withGlow = true } = Astro.props;
---

<div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden">
  {withGlow && (
    <div
      class="absolute inset-x-0 bottom-0 h-1/3 opacity-70"
      style="background: radial-gradient(ellipse at center bottom, rgba(255,140,30,0.18) 0%, rgba(200,57,10,0.08) 35%, transparent 65%);"
    />
  )}
  <canvas
    id="embers-canvas"
    data-intensity={intensity}
    class="absolute inset-0 h-full w-full"
  ></canvas>
</div>

<script>
  type Spark = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    life: number;
    maxLife: number;
    size: number;
    hue: number;
    seed: number;
    spawnX: number;
    spawnY: number;
    travelMax: number;
    volatility: number; // 0 = trajectòria estable, 1 = erràtica amb cops sobtats
  };

  const canvas = document.getElementById('embers-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true })!;
    const intensity = parseFloat(canvas.dataset.intensity ?? '1') || 1;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Detectar mòbil per perfil reduït: pointer:coarse OR ample petit OR pocs cores
    const isMobile =
      window.matchMedia('(pointer: coarse)').matches ||
      window.innerWidth < 768 ||
      (navigator.hardwareConcurrency ?? 8) <= 4;

    // Pressupost de partícules ajustat al dispositiu (sense blur, ja no cal)
    const profile = isMobile
      ? { sparks: 35, flames: 75, flameRate: 0.06, dprCap: 1 }
      : { sparks: 180, flames: 380, flameRate: 0.16, dprCap: 2 };

    const sparks: Spark[] = [];
    const MAX_SPARKS = Math.floor(profile.sparks * intensity);
    const intensityFinal = reduceMotion ? intensity * 0.4 : intensity;

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, profile.dprCap);

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, profile.dprCap);
      canvas.width = Math.max(1, Math.floor(width * dpr));
      canvas.height = Math.max(1, Math.floor(height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize);

    const random = (a: number, b: number) => a + Math.random() * (b - a);

    /**
     * Pre-render de sprites: clau per al rendiment en iOS Safari.
     * `ctx.filter = "blur(...)"` és lentíssim en iOS (no aprofita GPU);
     * dibuixar gradients radials cada frame també és car. Renderitzem
     * els blobs UNA SOLA vegada en canvas offscreen i durant el loop
     * només fem `drawImage`, que iOS sí accelera per hardware.
     */
    const SPRITE_SIZE = 96;
    const makeBlobSprite = (color: string) => {
      const off = document.createElement('canvas');
      off.width = off.height = SPRITE_SIZE;
      const c = off.getContext('2d')!;
      const cx = SPRITE_SIZE / 2;
      const grad = c.createRadialGradient(cx, cx, 0, cx, cx, cx);
      // El propi gradient dóna la suavitat — no fa falta blur posterior
      grad.addColorStop(0, color.replace(')', ', 1)').replace('hsl', 'hsla'));
      grad.addColorStop(0.45, color.replace(')', ', 0.45)').replace('hsl', 'hsla'));
      grad.addColorStop(1, color.replace(')', ', 0)').replace('hsl', 'hsla'));
      c.fillStyle = grad;
      c.fillRect(0, 0, SPRITE_SIZE, SPRITE_SIZE);
      return off;
    };

    // Etapes de color de la flama: jove (groc-blanc) → vell (vermell apagat)
    const flameSprites = [
      makeBlobSprite('hsl(54, 95%, 65%)'),
      makeBlobSprite('hsl(42, 95%, 60%)'),
      makeBlobSprite('hsl(28, 95%, 55%)'),
      makeBlobSprite('hsl(18, 95%, 48%)'),
      makeBlobSprite('hsl(8, 90%, 42%)'),
      makeBlobSprite('hsl(0, 80%, 35%)'),
    ];

    // Sprite per a chispes: més petit, nucli càlid amb halo
    const SPARK_SIZE = 32;
    const sparkSprite = (() => {
      const off = document.createElement('canvas');
      off.width = off.height = SPARK_SIZE;
      const c = off.getContext('2d')!;
      const cx = SPARK_SIZE / 2;
      const grad = c.createRadialGradient(cx, cx, 0, cx, cx, cx);
      grad.addColorStop(0, 'rgba(255, 245, 200, 1)');
      grad.addColorStop(0.25, 'rgba(255, 200, 100, 0.85)');
      grad.addColorStop(0.55, 'rgba(255, 130, 40, 0.45)');
      grad.addColorStop(1, 'rgba(255, 80, 20, 0)');
      c.fillStyle = grad;
      c.fillRect(0, 0, SPARK_SIZE, SPARK_SIZE);
      return off;
    })();

    /**
     * Espurna individual amb origen lliure (x, y arbitraris). Cada crackle
     * tria una posició nova al llarg de la base, com la fusta cremant
     * que cruix de manera impredictible.
     */
    const spawn = (originX: number, originY: number, opts: { burst?: number; force?: number } = {}) => {
      const burst = opts.burst ?? 1;
      const force = opts.force ?? 1;
      for (let i = 0; i < burst; i++) {
        if (sparks.length >= MAX_SPARKS) break;
        const x = originX + random(-4, 4);
        const y = originY + random(-3, 3);
        // Direcció aleatòria amb biaix cap amunt: la majoria pugen, però
        // algunes salten en diagonal o gairebé horitzontals. Cap explosió
        // radial perquè el burst és només 1-2 espurnes.
        // Distribució: 65% del con superior (-PI/2 ± 0.5),
        //              35% direccions més obertes (±1.4 rad ~ 80°)
        const angle = Math.random() < 0.65
          ? -Math.PI / 2 + random(-0.5, 0.5)
          : -Math.PI / 2 + random(-1.4, 1.4);
        const speed = random(6, 10) * force;
        const maxLife = random(220, 380);
        // Distància màxima de vol abans d'apagar-se completament:
        // entre 35% i 70% de l'alt del canvas (valor aleatori per espurna)
        const travelMax = height * random(0.35, 0.7);
        sparks.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          life: maxLife,
          maxLife,
          size: random(0.8, 1.5),
          hue: random(32, 48),
          seed: Math.random() * Math.PI * 2,
          spawnX: x,
          spawnY: y,
          travelMax,
          // Cada espurna té el seu temperament: algunes són tranquil·les
          // (volatility ~0.2), altres molt nervioses (~0.95)
          volatility: random(0.15, 0.95),
        });
      }
    };

    /**
     * Crackle: el cruixit de la fusta. Origen aleatori. Ja no genera "glow"
     * puntual perquè ara dibuixem una capa de flama persistent a la base.
     */
    const crackle = (intensityMul = 1) => {
      const ox = random(0.05, 0.95) * width;
      const oy = height - random(2, 30);
      const burst = Math.random() < 0.25 ? 2 : 1;
      spawn(ox, oy, { burst: Math.max(1, Math.round(burst * intensityMul)), force: random(0.9, 1.15) });
    };

    /**
     * Sistema de partícules de flama amb blur. Cada "punt calent" emet
     * blobs petits que pugen i s'enfreden (groc → taronja → vermell). Amb
     * el blur Gaussià es fonen entre si i formen una flama orgànica, no
     * cercles individuals.
     */
    type FlameParticle = {
      x: number;
      y: number;
      vx: number;
      vy: number;
      life: number;
      maxLife: number;
      size: number;
    };
    const flameParticles: FlameParticle[] = [];
    const FLAME_MAX = profile.flames;

    let flameAcc = 0;

    const emitFlameParticles = (dt: number) => {
      // Emissió uniforme al llarg de TOTA la base (sense punts calents).
      flameAcc += dt * profile.flameRate;
      if (flameAcc < 1) return;
      const toEmit = Math.floor(flameAcc);
      flameAcc -= toEmit;
      for (let n = 0; n < toEmit; n++) {
        // Posició x totalment aleatòria d'una banda a l'altra
        const sx = Math.random() * width;
        const sy = height + 6;
        if (flameParticles.length >= FLAME_MAX) flameParticles.shift();
        const life = 26 + Math.random() * 30;
        flameParticles.push({
          x: sx,
          y: sy,
          vx: (Math.random() - 0.5) * 0.6,
          vy: -1.2 - Math.random() * 1.8,
          life,
          maxLife: life, // mateix valor que life perquè lifeRatio comenci a 1
          size: 16 + Math.random() * 18,
        });
      }
    };

    const drawFlames = () => {
      // Composite additiu: les blobs se sumen creant zones càlides més brillants
      ctx.globalCompositeOperation = 'lighter';
      const stages = flameSprites.length;
      for (let i = 0; i < flameParticles.length; i++) {
        const p = flameParticles[i];
        // Clamp [0, 1] per garantir que stageIdx mai és negatiu
        const lifeRatio = Math.max(0, Math.min(1, p.life / p.maxLife));
        // Alpha: pic al mig de la vida, baix al naixement i al final
        const alphaCurve = Math.sin(lifeRatio * Math.PI);
        const alpha = alphaCurve * 0.42;
        if (alpha < 0.02) continue;
        // Triem sprite segons l'edat: jove (índex baix) → vell (índex alt)
        const stageIdx = Math.max(
          0,
          Math.min(stages - 1, Math.floor((1 - lifeRatio) * stages))
        );
        const sprite = flameSprites[stageIdx];
        const r = p.size * (0.7 + lifeRatio * 0.6) * 1.6;
        ctx.globalAlpha = alpha;
        ctx.drawImage(sprite, p.x - r, p.y - r, r * 2, r * 2);
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    };

    const updateFlames = (dtScale: number) => {
      for (let i = flameParticles.length - 1; i >= 0; i--) {
        const p = flameParticles[i];
        p.x += p.vx * dtScale;
        p.y += p.vy * dtScale;
        // L'aire calent les empeny una mica més amunt mentre s'enfreden
        p.vy -= 0.015 * dtScale;
        // Turbulència lateral suau perquè el cos de la flama oscil·li
        p.vx += (Math.random() - 0.5) * 0.18 * dtScale;
        p.vx *= 0.92;
        // Fricció vertical per limitar l'altura màxima de la flama
        p.vy *= 0.98;
        p.life -= dtScale;
        if (p.life <= 0 || p.y < height - 120) {
          flameParticles.splice(i, 1);
        }
      }
    };

    /** Programador de crackles: alterna silencis llargs amb ràfegues */
    let crackleTimer = 800 + Math.random() * 1400;
    let pendingDoubleCrackle = false;

    let last = performance.now();
    let raf = 0;
    // Gating: només para del tot si la pestanya canvia o el hero
    // surt del viewport. Durant scroll fem "low-power" en lloc de pausar.
    let tabVisible = document.visibilityState === 'visible';
    let inViewport = true;
    let running = false;
    // Throttle dinàmic: 1.0 = normal, valor menor = redueix emissió i frames
    let scrollThrottle = 1;

    const shouldRun = () => tabVisible && inViewport;

    const startLoop = () => {
      if (running || !shouldRun()) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(loop);
    };

    const stopLoop = () => {
      if (!running) return;
      running = false;
      cancelAnimationFrame(raf);
    };

    document.addEventListener('visibilitychange', () => {
      tabVisible = document.visibilityState === 'visible';
      if (shouldRun()) startLoop();
      else stopLoop();
    });

    // Scroll: redueix la càrrega però NO atura l'animació (perquè en mòbil
    // qualsevol toc dispara scroll i aturar la canvas amb cada toc fa que
    // la animació "salti"). Només considerem scroll real un canvi >2px.
    let scrollTimer: ReturnType<typeof setTimeout> | null = null;
    let lastScrollY = window.scrollY;
    const onScroll = () => {
      const dy = Math.abs(window.scrollY - lastScrollY);
      lastScrollY = window.scrollY;
      if (dy < 2) return; // ignorem micro-events provocats per touch
      scrollThrottle = 0.35; // mode eco: emissió i partícules reduïdes
      if (scrollTimer) clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        scrollThrottle = 1;
      }, 140);
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // IntersectionObserver: pausar quan el hero no està a la pantalla.
    // Estalvia molt CPU mentre l'usuari està a una secció més avall.
    const heroSection = canvas.closest('section');
    if (heroSection && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          inViewport = entries[0].isIntersecting;
          if (shouldRun()) startLoop();
          else stopLoop();
        },
        { threshold: 0, rootMargin: '50px' }
      );
      io.observe(heroSection);
    }

    const drawSpark = (s: Spark) => {
      const lifeRatio = Math.max(0, s.life / s.maxLife);
      const flicker = 0.72 + Math.sin(performance.now() / 60 + s.seed * 4) * 0.22 + Math.random() * 0.1;

      // Fade per distància 2D recorreguda des de l'origen
      const dx = s.x - s.spawnX;
      const dy = s.y - s.spawnY;
      const traveled = Math.sqrt(dx * dx + dy * dy);
      const fadeStart = s.travelMax * 0.5;
      const fadeRange = s.travelMax * 0.5;
      const fade =
        traveled > fadeStart ? Math.max(0, 1 - (traveled - fadeStart) / fadeRange) : 1;

      const alpha = lifeRatio * flicker * fade;
      if (alpha <= 0.02) return;

      // Sprite pre-rendered: 1 sola crida drawImage en lloc de 2 arcs+gradients
      const r = s.size * 4;
      ctx.globalAlpha = alpha;
      ctx.drawImage(sparkSprite, s.x - r, s.y - r, r * 2, r * 2);
    };

    const loop = (now: number) => {
      if (!running) return;
      raf = requestAnimationFrame(loop);
      const dt = Math.min(34, now - last);
      last = now;
      const dtScale = dt / 16.67;

      // Crackle: una espurna solitària surt cada poc, ràpida cap amunt.
      // Durant scroll real allarguem l'interval per emetre menys.
      crackleTimer -= dt;
      if (crackleTimer <= 0) {
        if (pendingDoubleCrackle) {
          crackle(1);
          pendingDoubleCrackle = false;
          crackleTimer = (600 + Math.random() * 1100) / scrollThrottle;
        } else {
          crackle(1);
          if (Math.random() < 0.25) {
            pendingDoubleCrackle = true;
            crackleTimer = (120 + Math.random() * 260) / scrollThrottle;
          } else {
            crackleTimer = (200 + Math.random() * 700) / (intensityFinal * scrollThrottle);
          }
        }
      }

      // Neteja agressiva del frame anterior per evitar acumulació
      ctx.globalCompositeOperation = 'source-over';
      ctx.clearRect(0, 0, width, height);

      // Llamas: emetre amb throttle dinàmic, actualitzar, dibuixar (amb blur)
      emitFlameParticles(dt * scrollThrottle);
      updateFlames(dtScale);
      drawFlames();

      ctx.globalCompositeOperation = 'lighter';

      for (let i = sparks.length - 1; i >= 0; i--) {
        const s = sparks[i];

        // física
        s.x += s.vx * dtScale;
        s.y += s.vy * dtScale;
        // resistència vertical mínima: la chispa manté l'empenta
        s.vy += 0.004 * dtScale;
        // Moviment siseant intens: dues oscil·lacions superposades de
        // diferent freqüència + ruido aleatori = vibració nerviosa
        const hissA = Math.sin(performance.now() / 35 + s.seed * 7) * 0.32;
        const hissB = Math.sin(performance.now() / 110 + s.seed * 3) * 0.22;
        s.vx += (hissA + hissB + (Math.random() - 0.5) * 0.4) * dtScale;

        // Kick lateral sobtat: probabilitat per frame que augmenta amb
        // la volatilitat de l'espurna. Algunes fan giravolts inesperats.
        const kickChance = 0.015 + s.volatility * 0.05;
        if (Math.random() < kickChance * dtScale) {
          // Volantazo: salta lateralment amb força variable
          const kickStrength = (1.2 + Math.random() * 2.4) * s.volatility;
          s.vx += (Math.random() < 0.5 ? -1 : 1) * kickStrength;
          // De vegades també un petit empenta vertical (la chispa "bota")
          if (Math.random() < 0.35) s.vy += (Math.random() - 0.5) * 1.2;
        }

        // Fricció lateral forta perquè el moviment quedi nerviós, no derivi
        s.vx *= 0.86;
        s.vy *= 0.999;

        s.life -= dtScale;

        drawSpark(s);

        // Mor quan ha recorregut tota la distància màxima (apagada total)
        // o quan surt fora del canvas
        const dx2 = s.x - s.spawnX;
        const dy2 = s.y - s.spawnY;
        const traveled2 = Math.sqrt(dx2 * dx2 + dy2 * dy2);
        if (
          s.life <= 0 ||
          traveled2 >= s.travelMax ||
          s.y < -20 ||
          s.x < -40 ||
          s.x > width + 40
        ) {
          sparks.splice(i, 1);
        }
      }

      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    };

    startLoop();
  }
</script>

<style>
  /* Forçar capa GPU pròpia (compositor) sense reservar memòria
     extra com fa will-change. translateZ(0) és el truc clàssic. */
  #embers-canvas {
    image-rendering: auto;
    transform: translateZ(0);
    contain: paint;
  }
  @media (prefers-reduced-motion: reduce) {
    #embers-canvas { opacity: 0.7; }
  }
</style>
